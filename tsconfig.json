{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/server.ts",
    "src/tui.tsx",
    "src/rpc.ts",
    "src/scheduler.ts",
    "src/delivery.ts",
    "src/history.ts",
    "src/config.ts",
    "src/time.ts",
    "tests/history.test.ts",
    "tests/scheduler.test.ts"
  ]
}
