{
  "name": "opencode-productivity-plugin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Local OpenCode plugin with prompt history search, scheduled wakeups, and background shell commands.",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./server": {
      "import": "./dist/src/server.js",
      "types": "./dist/src/server.d.ts"
    },
    "./tui": {
      "import": "./dist/src/tui.js",
      "types": "./dist/src/tui.d.ts"
    }
  },
  "files": [
    "dist/src",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "prepare:global-link": "node scripts/prepare-global-link.mjs",
    "link:global": "npm run build && npm run prepare:global-link && node scripts/link-global-config.mjs",
    "pack:dry": "npm pack --dry-run",
    "test:opencode": "npm run build && OPENCODE_REAL_MODEL_TESTS=1 node --test dist/tests/opencode-tools.integration.test.js",
    "check": "npm run build && npm test"
  },
  "engines": {
    "opencode": "^1.0.0 || ^2.0.0",
    "node": ">=26"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "fzf": "^0.5.2",
    "puppeteer-core": "^24.43.1",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.10"
  }
}
